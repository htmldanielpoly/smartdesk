# Copy to /opt/smartdesk/.env on the VM. Never commit the real file.
DOMAIN=smartdesk.example.com
# The deploy job rewrites this line to the commit it deployed.
IMAGE_TAG=latest
GITHUB_REPOSITORY=htmldanielpoly/smartdesk

# openssl rand -hex 32
JWT_SECRET=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

LOCAL_AI_ENABLED=true
AI_WORKERS=4
LLM_THREADS=
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WRITES=20
