# Copy to .env and fill in. docker-compose reads this file automatically.

# Secret used to sign JWTs. Generate a long random string for real use.
JWT_SECRET=change-me-in-prod

# OpenAI API key for the AI service. LEAVE EMPTY to run with rule-based
# fallbacks (no external calls). Set it to enable real AI classification,
# copilot drafts, and embedding-based duplicate detection.
OPENAI_API_KEY=

# OpenAI model used by the AI service when a key is set.
OPENAI_MODEL=gpt-4o-mini
