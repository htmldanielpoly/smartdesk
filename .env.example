# Copy to .env and fill in. docker-compose reads this file automatically.

# Secret used to sign JWTs. Generate a long random string for real use.
# Shared by api-service and forum-service (stateless auth between services).
JWT_SECRET=change-me-in-prod

# Local AI. The ai-service downloads two small open-weights models
# (~450 MB total) into a Docker volume on first start and serves them with
# llama.cpp on CPU — no API key, no external AI calls at inference time.
# Set LOCAL_AI_ENABLED=false to run with rule-based fallbacks only.
LOCAL_AI_ENABLED=true
AUTO_DOWNLOAD_MODELS=true

# Bootstrap admin: created at first startup if no admin exists yet.
# Leave both empty to skip (you can create one manually in Mongo instead).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please-1

# AI engine parallelism (ai-service). Worker tasks pull jobs off a priority
# queue (URGENT copilot drafts before LOW classifications; interactive work
# before batch work) and run them in threads; the two models have separate
# locks so an embedding and a chat completion run at the same time. Beyond
# AI_QUEUE_MAX queued jobs the engine answers 503 and the gateway falls back.
AI_WORKERS=4
AI_QUEUE_MAX=200
# CPU threads per model (empty = all cores). With two models in parallel,
# half the cores each is a good start on a small machine.
LLM_THREADS=

# Long-term memory. A new ticket that is (near-)identical to one an agent
# already resolved is answered by the AI itself, with the stored resolution,
# and never enters the agent queue (cosine similarity >= the threshold over
# the local embedding model; lexical fallback needs a near-verbatim repeat).
# Set AUTO_RESOLVE_ENABLED=false to always route every ticket to a human.
AUTO_RESOLVE_ENABLED=true
AUTO_RESOLVE_SIMILARITY_THRESHOLD=0.95

# Abuse protection. Budgets are per user (per address when not signed in),
# per 60-second window. RATE_LIMIT_REQUESTS is the general budget: the default
# 30 is fine for normal use, but the "Load Grid Incidents Demo" button creates
# 50 tickets at once — raise it before using that. RATE_LIMIT_WRITES is the
# stricter budget for comments, forum threads/posts and messages (spam).
# Bodies above MAX_REQUEST_BODY_BYTES are refused with 413 before being read.
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WRITES=20
MAX_REQUEST_BODY_BYTES=1048576
# Only behind a reverse proxy you control (takes the client address from
# X-Forwarded-For; spoofable otherwise).
TRUST_PROXY_HEADERS=false
# Media uploads (images/videos on comments, forum posts, messages): hard caps
# per type, enforced while the file streams in. Type is sniffed, not trusted.
MAX_IMAGE_BYTES=5242880
MAX_VIDEO_BYTES=26214400
